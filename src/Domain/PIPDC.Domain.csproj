<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain is the innermost layer: entities, enums, Result/Error. It is
       referenced by every other project and references nothing.

       One package, and only one: AppUser derives from IdentityUser, which is
       declared in the Microsoft.Extensions.Identity.Stores assembly (namespace
       Microsoft.AspNetCore.Identity). That package transitively brings
       Microsoft.Extensions.Identity.Core, so Application gets UserManager and
       RoleManager through the Domain project reference without declaring them. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="9.0.17" />
  </ItemGroup>

</Project>
