<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\PIPDC.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IAppDbContext deliberately exposes DbSet<T> and DatabaseFacade, so this
         is the real EF Core package, not Microsoft.EntityFrameworkCore.Abstractions
         (which does not contain DbSet<T>). The Npgsql provider is NOT referenced
         here - that belongs to Infrastructure. -->
    <!-- 9.0.20, not 9.0.17: Npgsql.EntityFrameworkCore.PostgreSQL 9.0.4 pulls
         Microsoft.EntityFrameworkCore.Relational 9.0.20, and pinning EF lower
         trips NU1605 (package downgrade). This is also the version the old
         single project actually compiled against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />

    <!-- IImageService/ImageService in Application/Services. -->
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
  </ItemGroup>

  <!-- The old single project used Microsoft.NET.Sdk.Web, whose implicit global
       usings covered these namespaces. Application/Infrastructure now build as
       plain class libraries, so re-declare that exact set here instead of
       editing ~50 source files to add the same using lines. Reproduces the
       pre-split compilation context one-for-one. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <!-- ASP.NET Core types used by Application: IFormFile on IImageService and
       ImageService. There is no narrow NuGet package for IFormFile in .NET 9 -
       it ships only in the Microsoft.AspNetCore.App shared framework. A
       FrameworkReference grants those types without granting any PIPDC.*
       assembly, so the project-reference layering is still compiler-enforced. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
