# Forces UTF-8 source encoding. Without this, an editor on Windows can round-trip
# a file through cp1252 and double-encode characters such as the em dash,
# which is how "â€”" previously entered the codebase.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2